# Datto Partner Portal → Admin → Integrations → API Keys (no client/vendor restriction)
DATTO_BCDR_PUBLIC_KEY=
DATTO_BCDR_SECRET_KEY=

# Bearer token for /mcp and /api (required as soon as the HTTP server is reachable from the network)
MCP_AUTH_TOKEN=

# Optional
# MCP_TRANSPORT=stdio                  # stdio (default) or http
# HOST=0.0.0.0
# PORT=3000
# ALLOWED_HOSTS=mcp.example.com        # Host header allowlist (DNS rebinding protection)
# DATTO_BCDR_CONCURRENCY=5
# DATTO_BCDR_RATE_LIMIT_PER_MINUTE=100 # Datto allows roughly 120/min per key
# DATTO_BCDR_CACHE_TTL_SECONDS=60      # 0 disables the cache
# DATTO_BCDR_TIMEOUT_MS=30000
# DATTO_BCDR_BASE_URL=https://api.datto.com/v1/bcdr
